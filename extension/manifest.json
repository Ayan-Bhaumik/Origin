{
  "manifest_version": 3,
  "name": "origin",
  "short_name": "origin",
  "version": "1.1.0",
  "description": "Move anything between your devices, instantly. Send text, links, pages, images and files to origin and get a short code.",
  "homepage_url": "https://origin.ayanbhaumik.in",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://origin.ayanbhaumik.in/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "origin",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
